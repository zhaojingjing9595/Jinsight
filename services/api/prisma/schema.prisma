generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  PERSONAL
  SHARED
}

enum TxType {
  INCOME
  EXPENSE
}

enum Period {
  MONTHLY
  WEEKLY
}

enum BudgetPlanType {
  TRIP
  EDUCATION
  MOVING
  EVENT
  CUSTOM
}

enum BudgetPlanStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum BudgetPlanRole {
  OWNER
  MEMBER
}

enum GoalType {
  TRIP_EVENT
  PURCHASE
  EMERGENCY
  DEBT
  CUSTOM
}

enum GoalStatus {
  PLANNING
  SAVING
  ACTIVE
  COMPLETE
}

enum BillRecurrence {
  MONTHLY
  ANNUAL
  WEEKLY
  CUSTOM
}

model User {
  id           String        @id
  email        String        @unique
  name         String?
  currency     String        @default("ILS")
  persona      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  goals        Goal[]
  bills        Bill[]
}

model Account {
  id                    String          @id @default(uuid())
  userId                String
  name                  String
  type                  AccountType     @default(PERSONAL)
  balance               Float           @default(0)
  openingBalance        Float?
  openingBalanceSources Json?
  createdAt             DateTime        @default(now())
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  members               AccountMember[]
  budgets               Budget[]
}

model AccountMember {
  id        String   @id @default(uuid())
  accountId String
  userId    String
  joinedAt  DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
}

model Transaction {
  id           String      @id @default(uuid())
  accountId    String
  amount       Float
  type         TxType
  category     String
  description  String?
  date         DateTime
  isRecurring  Boolean     @default(false)
  budgetPlanId String?
  goalId       String?
  excludeFromBudget Boolean @default(false)
  createdAt    DateTime    @default(now())
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  budgetPlan   BudgetPlan? @relation(fields: [budgetPlanId], references: [id], onDelete: SetNull)
  goal         Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model Budget {
  id         String           @id @default(uuid())
  accountId  String
  period     Period           @default(MONTHLY)
  month      Int
  year       Int
  totalLimit Float?
  rollover   Boolean          @default(false)
  createdBy  String
  createdAt  DateTime         @default(now())
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([accountId, month, year])
}

model BudgetCategory {
  id       String @id @default(uuid())
  budgetId String
  category String
  limit    Float
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category])
}

model BudgetPlan {
  id         String              @id @default(uuid())
  name       String
  type       BudgetPlanType
  startDate  DateTime
  endDate    DateTime?
  totalLimit Float
  status     BudgetPlanStatus    @default(PLANNED)
  notes      String?
  createdBy  String
  createdAt  DateTime            @default(now())
  members    BudgetPlanMember[]
  categories BudgetPlanCategory[]
  transactions Transaction[]
}

model BudgetPlanMember {
  id       String         @id @default(uuid())
  planId   String
  userId   String
  role     BudgetPlanRole @default(MEMBER)
  joinedAt DateTime       @default(now())
  plan     BudgetPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, userId])
}

model BudgetPlanCategory {
  id       String     @id @default(uuid())
  planId   String
  category String
  limit    Float
  plan     BudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, category])
}

model Goal {
  id           String     @id @default(uuid())
  userId       String
  type         GoalType   @default(CUSTOM)
  name         String
  emoji        String     @default("🎯")
  targetAmount Float
  savedAmount  Float      @default(0)
  startDate    DateTime?
  endDate      DateTime?
  status       GoalStatus @default(PLANNING)
  spendingPlan Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Bill {
  id             String          @id @default(uuid())
  userId         String
  name           String
  amount         Float
  dueDate        DateTime
  category       String          @default("utilities")
  recurrence     BillRecurrence  @default(MONTHLY)
  isRecurring    Boolean         @default(true)
  isSubscription Boolean         @default(false)
  reminderDays   Int             @default(3)
  isPaid         Boolean         @default(false)
  lastPaidDate   DateTime?
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}
