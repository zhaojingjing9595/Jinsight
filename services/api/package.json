{
  "name": "@jinsight/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@fastify/cors": "^10.0.2",
    "@jinsight/core": "workspace:*",
    "@prisma/client": "^6.6.0",
    "@supabase/supabase-js": "^2.103.0",
    "@trpc/server": "^11.1.2",
    "fastify": "^5.3.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@jinsight/config": "workspace:*",
    "@types/node": "^22",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
